# HTTP Security Headers
# ---------------------------------------------------------------------------
# IMPORTANT — GitHub Pages does not process this file natively.
# To enforce these headers on violetbridgesecurity.com, place the site behind
# Cloudflare (free tier) and configure HTTP Response Header Transform Rules,
# or migrate static hosting to Netlify or Cloudflare Pages which honour this
# file format directly.
#
# Until then, the meta-tag CSP in each HTML file provides partial coverage.
# The directives that ONLY work via HTTP headers (frame-ancestors, HSTS,
# Permissions-Policy, CORP, COOP) are documented here for CDN deployment.
# ---------------------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/index.html
  # script-src: 'unsafe-inline' removed; two remaining inline scripts are hash-pinned.
  # sha256 hashes must be recomputed if either inline script changes.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-xcJApNSusKezLwTADc8AQUfDi/hP0YFFCwUKPoDwBK0=' 'sha256-y2sGti/TQbuvyjzwTbywBKunPoQzROkiGOYYecn377s=' https://www.googletagmanager.com https://*.elfsight.com https://*.elfsightcdn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://*.elfsight.com https://*.elfsightcdn.com; font-src https://fonts.gstatic.com https://*.elfsightcdn.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://www.google-analytics.com https://*.elfsight.com https://*.elfsightcdn.com; frame-src https://*.elfsight.com https://*.elfsightcdn.com; form-action 'self' https://formspree.io; frame-ancestors 'none';

/service-request.html
  # No inline scripts remain — 'unsafe-inline' fully removed from script-src.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; frame-src 'none'; form-action 'self' https://formspree.io; frame-ancestors 'none';
